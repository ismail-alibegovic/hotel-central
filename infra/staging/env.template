# Hotel Central — hosted CMS staging environment (names only; NEVER commit values).
# Where to set: Vercel project "hotel-central-cms-demo" → Settings → Environment Variables
#   scope: Production only (the stable demo address is a production-target deployment of the `staging` branch;
#   preview deployments of other branches stay static). Full runbook: docs/operations/CMS_STAGING.md
# [S] = mark as "Sensitive" in Vercel.     Check before every deploy:  npm run cms:preflight -- staging
CMS_ENABLED=true                    # build + runtime
DATABASE_URL=                       # [S] Supabase PostgreSQL *transaction pooler* string (…pooler.supabase.com:6543/postgres);
                                    #     the direct db.<ref>.supabase.co host is IPv6-only and unreachable from Vercel
PAYLOAD_SECRET=                     # [S] openssl rand -base64 48   (>= 32 chars, unique per environment)
NEXT_PUBLIC_SERVER_URL=             # https://<stable staging origin>, no trailing slash
BLOB_READ_WRITE_TOKEN=              # [S] injected by Vercel when the Blob store is connected to the project
# --- first run only (npm run cms:seed), DELETE afterwards (an empty value is not the same as deleted) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=                # [S]
# --- must stay UNSET on staging ---
# NEXT_PUBLIC_SITE_URL      (setting it makes the site indexable under the official URL)
# ALLOW_FIRST_REGISTER      (re-opens the first-user takeover window)
# CMS_ALLOW_SAMPLE_PUBLISH  (would allow publishing DEMO / SAMPLE sections)
# MEDIA_DIR                 (local disk is not durable on serverless)
# Schema changes are migrations (src/migrations), applied deliberately with `npm run cms:migrate`; the build never migrates.
