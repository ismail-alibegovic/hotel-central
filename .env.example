# Variable NAMES only. Never commit real values; copy to .env.local for development.

# Public canonical origin used for metadata, sitemap, robots and JSON-LD.
# Leave unset on demo/preview deployments (they are noindexed and use their own origin).
# Set to the official domain only for the production launch.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (Resend). If unset, POST /api/contact answers 503 and the form shows an honest fallback.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# --- CMS (Payload) — leave all unset to run the site on static content only ---
# Set to "true" to enable /admin, the CMS API and CMS-driven content (pages: about, room: junior-suite).
CMS_ENABLED=
# MongoDB connection string (Atlas M0 for dev/staging). Never commit.
DATABASE_URL=
# Long random string used to sign auth tokens. Required when CMS_ENABLED=true.
PAYLOAD_SECRET=
# Public origin of this deployment (used by live preview), e.g. https://<staging>.vercel.app
NEXT_PUBLIC_SERVER_URL=
# Vercel Blob read/write token for media (staging/production). Without it uploads go to MEDIA_DIR (local dev/test only).
BLOB_READ_WRITE_TOKEN=
MEDIA_DIR=
# Optional bootstrap admin for seeding dev/staging (npm run cms:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Emergency only: set to "true" to re-open /api/users/first-register on an EMPTY database (anyone could claim the admin account).
# Normally leave unset and create the first administrator with `npm run cms:seed`.
ALLOW_FIRST_REGISTER=
# Staging only: set to "true" to allow publishing pages that still contain DEMO / SAMPLE sections (e.g. for a stakeholder demo).
# Must be unset in production (cms:preflight enforces this).
CMS_ALLOW_SAMPLE_PUBLISH=
